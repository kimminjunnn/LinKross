{
  "name": "linkross",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "sandbox:snapshot": "node scripts/create-verification-sandbox-snapshot.mjs",
    "test": "node --experimental-strip-types --import ./scripts/register-test-hooks.mjs --test src/lib/__tests__/*.test.ts",
    "eval:sow": "node --experimental-strip-types --import ./eval/load-env.mjs --import ./scripts/register-test-hooks.mjs eval/run-sow-eval.mjs",
    "eval:models": "node --experimental-strip-types --import ./eval/load-env.mjs --import ./scripts/register-test-hooks.mjs eval/compare-models.mjs",
    "eval:composition": "node --experimental-strip-types --conditions=react-server --import ./eval/load-env.mjs --import ./scripts/register-test-hooks.mjs eval/run-composition-eval.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/sandbox": "^3.0.0",
    "ethers": "^6.17.0",
    "lucide-react": "^1.31.0",
    "mammoth": "^1.12.1",
    "next": "16.3.0",
    "openai": "^7.4.0",
    "pdf-parse": "^1.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
