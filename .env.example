# SOW 마일스톤 분석과 영문 초안 생성에 사용하는 서버 전용 키/모델.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Supabase 대시보드 Connect 버튼 > App Frameworks > Next.js에서 확인 (publishable key는 공개용 키).
# 비어있으면 로그인 미들웨어가 비활성화된다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# GitHub App 서버 전용 설정
GITHUB_APP_ID=4630646
# GitHub에서 내려받은 PEM 파일 전체를 base64 한 줄로 변환한 값이다.
# Private Key 원문과 이 값은 Git 또는 채팅에 공유하지 않는다.
GITHUB_APP_PRIVATE_KEY_BASE64=
# 로컬 개발에서는 PEM 원문 대신 파일 경로를 지정할 수 있다. 배포 환경에서는 사용하지 않는다.
GITHUB_APP_PRIVATE_KEY_PATH=

# GitHub App webhook 서명 검증용 서버 전용 secret
GITHUB_WEBHOOK_SECRET=

# webhook 및 신뢰된 Runner 제어 계층에서만 사용하는 서버 전용 Supabase service role key
SUPABASE_SERVICE_ROLE_KEY=

# 신뢰된 Runner 조정기 인증용 서버 secret. 최소 32자 무작위 값으로 설정하고 검수 컨테이너에는 전달하지 않는다.
VERIFICATION_RUNNER_SECRET=

# Vercel 배포에서는 OIDC 인증을 우선 사용한다. 외부/로컬 조정기에서만 세 값을 함께 설정한다.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
# 자동 E2E에 필요: `npm run sandbox:snapshot` 출력값. 없으면 자동 조건은 확인 필요로 남는다.
VERIFICATION_SANDBOX_SNAPSHOT_ID=
