# Base Sepolia 온체인 검증(POST /api/payments/record)에 사용할 RPC 엔드포인트.
# 비워두면 공개 RPC(https://sepolia.base.org)를 사용한다.
BASE_SEPOLIA_RPC=

# Supabase 대시보드 Connect 버튼 > App Frameworks > Next.js에서 확인 (publishable key는 공개용 키).
# 비어있으면 로그인 미들웨어가 비활성화된다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
