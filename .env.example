# SOW 마일스톤 분석과 영문 초안 생성에 사용하는 서버 전용 키/모델.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Supabase 대시보드 Connect 버튼 > App Frameworks > Next.js에서 확인 (publishable key는 공개용 키).
# 비어있으면 로그인 미들웨어가 비활성화된다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 공개 GitHub API의 낮은 비인증 rate limit을 피할 때만 서버 환경에 설정한다.
# 클라이언트에 노출되는 NEXT_PUBLIC_ 접두사를 사용하지 않는다.
GITHUB_TOKEN=
